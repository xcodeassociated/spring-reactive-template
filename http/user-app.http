### Permissions

###
GET {{host}}/coroutine/permissions?page=0&size=10&sort=id&direction=DESC
Authorization: Bearer {{oauthToken}}

###
POST {{host}}/coroutine/permissions
Content-Type: application/json
Authorization: Bearer {{oauthToken}}

{"name": "test-{{$random.integer(0, 100)}}", "description": "test description coroutine"}

> {%
client.global.set("permissionId", response.body._id)
 %}

###
GET {{host}}/coroutine/permissions/{{permissionId}}
Authorization: Bearer {{oauthToken}}

###
PUT {{host}}/coroutine/permissions/{{permissionId}}
Content-Type: application/json
Authorization: Bearer {{oauthToken}}

{"name": "test-coroutine-changed: {{$uuid}}", "description": "test description coroutine changed!", "version":  0}

###
DELETE {{host}}/coroutine/permissions/{{permissionId}}
Authorization: Bearer {{oauthToken}}

> {%
client.global.set("permissionId", null)
 %}

### User

###
GET {{host}}/coroutine/users?page=0&size=10&sort=id&direction=ASC
Authorization: Bearer {{oauthToken}}

###
GET {{host}}/coroutine/usersCount
Authorization: Bearer {{oauthToken}}

###
POST {{host}}/coroutine/users
Content-Type: application/json
Authorization: Bearer {{oauthToken}}

{"name": "user: {{$uuid}}", "email":  "{{$random.email}}", "role": ["{{permissionId}}"]}

> {%
    client.global.set("userId", response.body._id)
%}

###
PUT {{host}}/coroutine/users/{{userId}}
Content-Type: application/json
Authorization: Bearer {{oauthToken}}

{"name": "user changed: {{$uuid}}", "email":  "{{$random.email}}", "role": ["{{permissionId}}"], "version": 0}

###
GET {{host}}/coroutine/users/{{userId}}
Authorization: Bearer {{oauthToken}}

###
DELETE {{host}}/coroutine/users/{{userId}}
Authorization: Bearer {{oauthToken}}

> {%
    client.global.set("userId", null)
%}

###
GET {{host}}/coroutine/usersCount
Authorization: Bearer {{oauthToken}}

### GraphQL

GRAPHQL {{host}}/graphql
Content-Type: application/graphql
Authorization: Bearer {{oauthToken}}

query {
    getAllUsers(page: 0, size:10, sort:"id", direction:"ASC") {
        id,
        name,
        permissions {
          id,
          name,
          description
        },
        version
  }
}

###